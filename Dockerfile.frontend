# =============================================
# Stage 1: Build
# =============================================
FROM node:20-alpine AS build
WORKDIR /app

# 复制前端代码（从仓库根目录看，需要先进入 frontend）
COPY frontend/package*.json ./
RUN npm ci

COPY frontend/ ./
RUN npm run build

# =============================================
# Stage 2: Serve
# =============================================
FROM nginx:alpine
COPY --from=build /app/dist /usr/share/nginx/html
EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]